# Base URL REST API VoteDel (back-end repository terpisah).
# Lokal  : gunakan /api agar diteruskan proxy Vite ke VITE_DEV_API_PROXY.
# Produksi: isi URL HTTPS back-end yang sudah dideploy, contoh https://votedel-api.example.com/api
VITE_API_URL=/api
VITE_DEV_API_PROXY=http://localhost:8000
VITE_BASE_PATH=/
APP_PORT=3000
