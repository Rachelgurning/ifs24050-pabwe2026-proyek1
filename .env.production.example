# Isi dengan endpoint HTTPS backend yang dapat diakses publik sebelum build produksi.
# Jangan gunakan localhost untuk penilaian publik.
VITE_API_URL=https://api-domain-anda.example/api
# Root domain: /
# Jika aplikasi dihosting di subpath, samakan dengan prefix hosting, misalnya /vote-del/
VITE_BASE_PATH=/
